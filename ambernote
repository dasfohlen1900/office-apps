fileInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (event) => {
    try {
      const parsed = JSON.parse(event.target.result);
      let pagesHtml;
      if (parsed.pages !== undefined) {
        pagesHtml = parsed.pages;
      } else if (parsed.content !== undefined) {
        pagesHtml = [parsed.content]; /* Abwärtskompatibilität zu Version 1/2 */
      } else {
        throw new Error('Ungültiges Notiz-Format');
      }

      hideStartScreen();
      loadPagesFromHtmlArray(pagesHtml);
      rebindAllImageEvents();
      docTitleInput.value = file.name;

      if (parsed.metadata) {
        currentMetadata = {
          created: parsed.metadata.created || new Date().toISOString(),
          lastModified: parsed.metadata.lastModified || new Date().toISOString()
        };
        currentNoteType = parsed.metadata.noteType && noteTemplates[parsed.metadata.noteType] ? parsed.metadata.noteType : '';
        noteTypeSelect.value = currentNoteType;
        noteTypeInfoEl.textContent = 'Typ: ' + (currentNoteType ? noteTemplates[currentNoteType].label : 'Leer');
      } else {
        currentMetadata = { created: new Date().toISOString(), lastModified: new Date().toISOString() };
      }

      updateCounters();
      addRecentDoc(file.name);
      showStatus(`Datei "${file.name}" geöffnet`);
    } catch (err) {
      alert('Fehler beim Laden der Datei. Es handelt sich nicht um eine gültige .note-Datei.');
      console.error(err);
    }
  };
  reader.readAsText(file);
  fileInput.value = '';
});

/* ================================================================ */
/* DRUCKEN                                                            */
/* ================================================================ */
document.getElementById('btn-print').addEventListener('click', () => window.print());

/* ================================================================ */
/* EXPORT: PDF & DOCX                                                */
/* ================================================================ */
document.getElementById('export-pdf-tile').addEventListener('click', async () => {
  closeBackstage();
  showStatus('PDF wird erstellt...');
  try {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF('p', 'pt', 'a4');
    const pages = Array.from(workspace.querySelectorAll('.document-page'));
    for (let i = 0; i < pages.length; i++) {
      const canvas = await html2canvas(pages[i], { scale: 2, backgroundColor: '#ffffff' });
      const imgData = canvas.toDataURL('image/jpeg', 0.92);
      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const imgHeight = (canvas.height * pageWidth) / canvas.width;
      if (i > 0) pdf.addPage();
      pdf.addImage(imgData, 'JPEG', 0, 0, pageWidth, Math.min(imgHeight, pageHeight));
    }
    const filename = (docTitleInput.value.replace(/\.note$/, '') || 'Dokument') + '.pdf';
    pdf.save(filename);
    showStatus('PDF-Export abgeschlossen');
  } catch (err) {
    console.error(err);
    alert('Beim PDF-Export ist ein Fehler aufgetreten: ' + err.message);
  }
});

document.getElementById('export-docx-tile').addEventListener('click', async () => {
  closeBackstage();
  showStatus('Word-Dokument wird erstellt...');
  try {
    const { Document, Packer, Paragraph, TextRun, HeadingLevel, PageBreak } = window.docx;
    const pages = Array.from(workspace.querySelectorAll('.document-page'));
    const children = [];

    pages.forEach((page, pIndex) => {
      const blockElements = page.querySelectorAll('h1,h2,h3,p,li');
      if (blockElements.length === 0) {
        children.push(new Paragraph({ children: [new TextRun(page.innerText || '')] }));
      } else {
        blockElements.forEach(el => {
          const text = el.innerText || '';
          if (el.tagName === 'H1') children.push(new Paragraph({ text, heading: HeadingLevel.HEADING_1 }));
          else if (el.tagName === 'H2') children.push(new Paragraph({ text, heading: HeadingLevel.HEADING_2 }));
          else if (el.tagName === 'H3') children.push(new Paragraph({ text, heading: HeadingLevel.HEADING_3 }));
          else if (el.tagName === 'LI') children.push(new Paragraph({ text: '• ' + text }));
          else children.push(new Paragraph({
            children: [new TextRun({
              text,
              bold: !!el.querySelector('b, strong') || window.getComputedStyle(el).fontWeight >= 600,
              italics: !!el.querySelector('i, em')
            })]
          }));
        });
      }
      if (pIndex < pages.length - 1) {
        children.push(new Paragraph({ children: [new PageBreak()] }));
      }
    });

    const doc = new Document({ sections: [{ properties: {}, children }] });
    const blob = await Packer.toBlob(doc);
    const filename = (docTitleInput.value.replace(/\.note$/, '') || 'Dokument') + '.docx';
    window.saveAs(blob, filename);
    showStatus('Word-Export abgeschlossen');
  } catch (err) {
    console.error(err);
    alert('Beim Word-Export ist ein Fehler aufgetreten: ' + err.message);
  }
});

/* ================================================================ */
/* TASTENKOMBINATIONEN (GLOBAL)                                      */
/* ================================================================ */
document.addEventListener('keydown', (e) => {
  const ctrlOrCmd = e.ctrlKey || e.metaKey;
  if (!ctrlOrCmd) return;
  const key = e.key.toLowerCase();
  if (key === 's') { e.preventDefault(); saveNoteFile(); }
  else if (key === 'o') { e.preventDefault(); fileInput.click(); }
  else if (key === 'p') { e.preventDefault(); window.print(); }
  else if (key === 'l') { e.preventDefault(); document.execCommand('justifyLeft'); }
  else if (key === 'e') { e.preventDefault(); document.execCommand('justifyCenter'); }
  else if (key === 'r') { e.preventDefault(); document.execCommand('justifyRight'); }
  else if (key === 'j') { e.preventDefault(); document.execCommand('justifyFull'); }
});

/* ================================================================ */
/* UTILS                                                              */
/* ================================================================ */
function showStatus(message) {
  statusMsgEl.textContent = message;
  clearTimeout(showStatus._t);
  showStatus._t = setTimeout(() => { statusMsgEl.textContent = 'Bereit'; }, 3000);
}

/* ================================================================ */
/* INITIALISIERUNG                                                   */
/* ================================================================ */
showStartScreen();
showStatus('AmberNote bereit');

});
</script>
