btnLocalFont.addEventListener('click', async () => {
  if (!('queryLocalFonts' in window)) {
    alert('Die Local Font Access API wird von diesem Browser nicht unterstützt. Sie funktioniert derzeit nur in Chromium-basierten Browsern (z. B. Chrome, Edge) über HTTPS oder localhost.');
    return;
  }
  try {
    const availableFonts = await window.queryLocalFonts();
    const familySet = new Set();
    availableFonts.forEach(fontData => familySet.add(fontData.family));
    const sortedFamilies = Array.from(familySet).sort((a, b) => a.localeCompare(b));
    const separator = document.createElement('option');
    separator.disabled = true;
    separator.textContent = '── Lokale Schriftarten ──';
    fontSelect.appendChild(separator);
    sortedFamilies.forEach(family => {
      const option = document.createElement('option');
      option.value = family;
      option.textContent = family;
      fontSelect.appendChild(option);
    });
    showStatus(sortedFamilies.length + ' lokale Schriftarten geladen');
  } catch (err) {
    console.error(err);
    if (err.name === 'SecurityError' || err.name === 'NotAllowedError') {
      alert('Zugriff auf lokale Schriftarten wurde verweigert. Bitte erlaube den Zugriff im Berechtigungsdialog des Browsers.');
