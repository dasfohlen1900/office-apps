function insertImageAtCursor(dataUrl, naturalWidth, naturalHeight) {
  if (activePage) activePage.focus();
  restoreSelectionRange();
  const maxWidth = 500;
  const scale = naturalWidth > maxWidth ? maxWidth / naturalWidth : 1;
  const w = Math.round(naturalWidth * scale);
  const h = Math.round(naturalHeight * scale);

  const wrapId = 'imgwrap-' + Date.now();
  const html = `<span class="img-wrap" id="${wrapId}" contenteditable="false" data-x="0" data-y="0" data-w="${w}" data-h="${h}">
    <img src="${dataUrl}" style="width:${w}px;height:${h}px;">
    <span class="resize-handle tl"></span><span class="resize-handle tr"></span>
    <span class="resize-handle bl"></span><span class="resize-handle br"></span>
  </span>&nbsp;`;
  document.execCommand('insertHTML', false, html);
  setTimeout(() => {
    const wrapEl = document.getElementById(wrapId);
    if (wrapEl) attachImageResizeEvents(wrapEl);
  }, 0);
  updateCounters();
}

function attachImageResizeEvents(wrapEl) {
  const img = wrapEl.querySelector('img');
  wrapEl.querySelectorAll('.resize-handle').forEach(handle => {
    handle.addEventListener('mousedown', (e) => {
      e.preventDefault();
      e.stopPropagation();
      selectImage(wrapEl);
      const startX = e.clientX, startY = e.clientY;
      const startW = img.offsetWidth, startH = img.offsetHeight;
      const corner = handle.classList.contains('tl') ? 'tl' : handle.classList.contains('tr') ? 'tr' : handle.classList.contains('bl') ? 'bl' : 'br';

      function onMove(ev) {
        const dx = ev.clientX - startX;
        const dy = ev.clientY - startY;
        let newW = startW, newH = startH;
        if (corner === 'br') { newW = startW + dx; newH = startH + dy; }
        else if (corner === 'bl') { newW = startW - dx; newH = startH + dy; }
        else if (corner === 'tr') { newW = startW + dx; newH = startH - dy; }
        else if (corner === 'tl') { newW = startW - dx; newH = startH - dy; }
        newW = Math.max(30, newW);
        newH = Math.max(30, newH);
        img.style.width = newW + 'px';
        img.style.height = newH + 'px';
        wrapEl.setAttribute('data-w', Math.round(newW));
        wrapEl.setAttribute('data-h', Math.round(newH));
      }
      function onUp() {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        const rect = wrapEl.getBoundingClientRect();
        const pageRect = wrapEl.closest('.document-page').getBoundingClientRect();
        wrapEl.setAttribute('data-x', Math.round(rect.left - pageRect.left));
        wrapEl.setAttribute('data-y', Math.round(rect.top - pageRect.top));
        updateCounters();
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });
}

function selectImage(wrapEl) {
  deselectImage();
  wrapEl.classList.add('selected');
  activeImageWrap = wrapEl;
