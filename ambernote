
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AmberNote</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%23D97706'/%3E%3Cpath d='M7 4h7l4 4v12H7z' fill='none' stroke='white' stroke-width='1.6'/%3E%3Cpath d='M14 4v4h4' fill='none' stroke='white' stroke-width='1.6'/%3E%3Cline x1='9' y1='13' x2='15' y2='13' stroke='white' stroke-width='1.4'/%3E%3Cline x1='9' y1='16' x2='15' y2='16' stroke='white' stroke-width='1.4'/%3E%3C/svg%3E">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/docx/8.5.0/index.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<style>
:root{
  --primary-color:#D97706; --primary-hover:#B45309; --primary-light:#FDE9CF;
  --bg-app:#f3f2f1; --bg-ribbon:#f7f9fa; --bg-editor-area:#e6e6e6;
  --border-color:#d1d1d1; --text-main:#333333;
  --toolbar-btn-hover:#e1dfdd; --toolbar-btn-active:#c8c6c4;
  --shadow-page:0 4px 12px rgba(0,0,0,0.15);
  --excel-green:#217346; --excel-green-dark:#14532d; --excel-green-light:#e7f4ec;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;background:var(--bg-app);color:var(--text-main);height:100vh;display:flex;flex-direction:column;overflow:hidden;}

/* ===================== STARTSEITE ===================== */
.start-screen{position:fixed;inset:0;background:linear-gradient(135deg,#fff 0%,#fdf3e4 100%);z-index:1200;display:flex;flex-direction:column;}
.start-screen.hidden{display:none;}
.start-header{display:flex;align-items:center;gap:12px;padding:26px 50px;}
.start-header svg{width:34px;height:34px;color:var(--primary-color);}
.start-header h1{font-size:24px;font-weight:600;color:#333;}
.start-body{flex:1;display:flex;padding:0 50px 40px;gap:50px;overflow-y:auto;}
.start-col{flex:1;}
.start-col h2{font-size:15px;font-weight:600;color:#555;margin-bottom:16px;text-transform:uppercase;letter-spacing:.03em;}
.start-new-tile{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--border-color);border-radius:8px;padding:16px 18px;cursor:pointer;margin-bottom:12px;max-width:480px;transition:box-shadow .15s,border-color .15s;}
.start-new-tile:hover{border-color:var(--primary-color);box-shadow:0 3px 10px rgba(217,118,6,.18);}
.start-new-tile svg{width:28px;height:28px;color:var(--primary-color);flex-shrink:0;}
.start-new-tile-title{font-size:14px;font-weight:600;color:#222;}
.start-new-tile-desc{font-size:12px;color:#777;margin-top:2px;}
.start-template-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;max-width:620px;}
.start-template-card{border:1px solid var(--border-color);border-radius:8px;padding:16px 10px;cursor:pointer;text-align:center;background:#fff;transition:.15s;}
.start-template-card:hover{border-color:var(--primary-color);box-shadow:0 3px 10px rgba(217,118,6,.18);transform:translateY(-2px);}
.start-template-card svg{width:26px;height:26px;color:var(--primary-color);margin-bottom:8px;}
.start-template-card-name{font-size:12px;font-weight:600;color:#333;}
.start-recent-list{max-width:480px;}
.start-recent-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:6px;cursor:pointer;font-size:13px;color:#444;}
.start-recent-item:hover{background:var(--primary-light);}
.start-recent-item svg{width:18px;height:18px;color:var(--primary-color);flex-shrink:0;}
.start-recent-empty{font-size:13px;color:#999;padding:10px 0;}
.start-open-btn{display:flex;align-items:center;gap:10px;background:var(--primary-color);color:#fff;border:none;border-radius:6px;padding:10px 18px;font-size:13px;cursor:pointer;margin-top:16px;}
.start-open-btn:hover{background:var(--primary-hover);}
.start-open-btn svg{width:16px;height:16px;}

/* ===================== HEADER ===================== */
.app-header{background:var(--primary-color);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:6px 16px;height:40px;flex-shrink:0;}
.app-title{font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;}
.doc-title-input{background:transparent;border:1px solid transparent;color:#fff;font-size:14px;font-weight:500;padding:2px 6px;border-radius:3px;outline:none;transition:.2s;}
.doc-title-input:hover,.doc-title-input:focus{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.3);}
.header-actions{display:flex;align-items:center;gap:8px;}
.header-btn{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;display:flex;align-items:center;gap:5px;}
.header-btn:hover{background:rgba(255,255,255,.25);}
.header-btn svg{width:13px;height:13px;}
.header-btn.spellcheck-off{opacity:.55;}

/* ===================== RIBBON ===================== */
.ribbon{background:var(--bg-ribbon);border-bottom:1px solid var(--border-color);box-shadow:0 2px 4px rgba(0,0,0,.04);user-select:none;flex-shrink:0;}
.ribbon-tabs{display:flex;background:var(--primary-color);padding-left:10px;}
.ribbon-tab{padding:6px 16px;color:#fff;font-size:13px;cursor:pointer;border-top-left-radius:4px;border-top-right-radius:4px;opacity:.85;transition:.15s;}
.ribbon-tab:hover{opacity:1;background:rgba(255,255,255,.12);}
.ribbon-tab.active{background:var(--bg-ribbon);color:var(--primary-color);font-weight:600;opacity:1;}
.ribbon-tab.file-tab{font-style:italic;}
.ribbon-content{display:none;align-items:center;padding:6px 12px;gap:16px;height:65px;overflow-x:auto;}
.ribbon-content.active{display:flex;}
.ribbon-group{display:flex;align-items:center;gap:4px;position:relative;padding-right:10px;}
.ribbon-group:not(:last-child)::after{content:"";position:absolute;right:-2px;top:10%;height:80%;width:1px;background:var(--border-color);}
.btn{background:transparent;border:1px solid transparent;border-radius:3px;padding:6px 8px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;color:var(--text-main);transition:.15s;}
.btn:hover{background:var(--toolbar-btn-hover);border-color:var(--border-color);}
.btn:active,.btn.active{background:var(--toolbar-btn-active);border-color:#a19f9d;}
.btn-inline{flex-direction:row;padding:6px;}
.btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.btn-large svg{width:22px;height:22px;}
select,input[type=color]{font-family:inherit;font-size:12px;padding:5px 6px;border:1px solid var(--border-color);border-radius:3px;background:#fff;color:var(--text-main);cursor:pointer;outline:none;}
select:hover{border-color:var(--primary-color);}
#font-size{width:55px;}
#font{width:165px;}
input[type=color]{width:32px;height:32px;padding:2px;}

/* ===================== WORKSPACE / MULTI-PAGE ===================== */
.workspace{flex:1;background:var(--bg-editor-area);overflow-y:auto;display:flex;flex-direction:column;align-items:center;padding:30px 15px 100px;gap:24px;}
.document-page{background:#fff;width:100%;max-width:800px;min-height:1050px;padding:60px 70px;box-shadow:var(--shadow-page);border-radius:2px;outline:none;font-family:'Calibri','Segoe UI',sans-serif;font-size:15px;line-height:1.6;color:#111;position:relative;}
.document-page:focus{border:1px solid rgba(217,118,6,.3);}
.page-number-tag{position:absolute;bottom:-22px;right:6px;font-size:11px;color:#888;}
.add-page-btn{width:54px;height:54px;border-radius:50%;background:var(--primary-color);color:#fff;border:none;box-shadow:0 3px 10px rgba(0,0,0,.25);cursor:pointer;display:flex;align-items:center;justify-content:center;position:fixed;bottom:52px;right:34px;z-index:50;}
.add-page-btn:hover{background:var(--primary-hover);}
.add-page-btn svg{width:26px;height:26px;}

/* Bilder + Resize Handles */
.img-wrap{position:relative;display:inline-block;}
.img-wrap.selected{outline:2px solid var(--primary-color);}
.img-wrap img{display:block;max-width:100%;}
.resize-handle{position:absolute;width:11px;height:11px;background:var(--primary-color);border:1px solid #fff;border-radius:50%;display:none;}
.img-wrap.selected .resize-handle{display:block;}
.resize-handle.br{right:-6px;bottom:-6px;cursor:nwse-resize;}
.resize-handle.bl{left:-6px;bottom:-6px;cursor:nesw-resize;}
.resize-handle.tr{right:-6px;top:-6px;cursor:nesw-resize;}
.resize-handle.tl{left:-6px;top:-6px;cursor:nwse-resize;}

/* Rechtschreibprüfung */
.spell-error{text-decoration:underline wavy #e11d48;text-decoration-skip-ink:none;cursor:context-menu;}
.spell-menu{position:fixed;background:#fff;border:1px solid var(--border-color);border-radius:6px;box-shadow:0 6px 20px rgba(0,0,0,.2);z-index:2000;min-width:180px;padding:4px 0;font-size:13px;}
.spell-menu-item{padding:8px 14px;cursor:pointer;}
.spell-menu-item:hover{background:var(--primary-light);}
.spell-menu-sep{height:1px;background:var(--border-color);margin:4px 0;}

/* ===================== STATUS BAR ===================== */
.status-bar{background:var(--primary-color);color:#fff;font-size:12px;padding:4px 16px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;}
.status-info{display:flex;gap:16px;align-items:center;}
.status-info button{background:none;border:none;color:#fff;font-size:12px;cursor:pointer;text-decoration:underline;padding:0;}
#file-input,#img-file-input{display:none;}

/* ===================== BACKSTAGE ===================== */
.backstage-overlay{position:fixed;inset:0;background:#fff;z-index:999;display:none;}
.backstage-overlay.open{display:flex;}
.backstage-nav{width:230px;background:var(--primary-color);color:#fff;display:flex;flex-direction:column;padding-top:20px;flex-shrink:0;}
.backstage-nav-item{padding:12px 24px;font-size:14px;cursor:pointer;display:flex;align-items:center;gap:10px;border-left:4px solid transparent;}
.backstage-nav-item:hover{background:rgba(255,255,255,.12);}
.backstage-nav-item.active{background:rgba(255,255,255,.2);border-left-color:#fff;font-weight:600;}
.backstage-nav-item svg{width:16px;height:16px;flex-shrink:0;}
.backstage-close{margin-top:auto;padding:14px 24px;display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;border-top:1px solid rgba(255,255,255,.2);}
.backstage-close:hover{background:rgba(255,255,255,.12);}
.backstage-panel{flex:1;padding:40px 60px;overflow-y:auto;}
.backstage-panel h2{font-size:24px;font-weight:400;color:#333;margin-bottom:24px;border-bottom:1px solid var(--border-color);padding-bottom:14px;}
.backstage-section{display:none;}
.backstage-section.active{display:block;}
.backstage-tile{display:flex;align-items:center;gap:16px;padding:14px 16px;border-radius:4px;cursor:pointer;max-width:420px;transition:background .15s;}
.backstage-tile:hover{background:var(--primary-light);}
.backstage-tile svg{width:30px;height:30px;color:var(--primary-color);flex-shrink:0;}
.backstage-tile-title{font-size:15px;font-weight:600;color:#222;}
.backstage-tile-desc{font-size:12px;color:#666;margin-top:2px;}
.meta-table{border-collapse:collapse;max-width:520px;}
.meta-table td{padding:10px 14px;border-bottom:1px solid var(--border-color);font-size:13px;}
.meta-table td:first-child{color:#666;width:190px;}
.meta-table td:last-child{font-weight:600;color:#222;}
.template-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px;max-width:700px;margin-top:10px;}
.template-card{border:1px solid var(--border-color);border-radius:4px;padding:14px 10px;cursor:pointer;text-align:center;background:#fafafa;transition:.15s;}
.template-card:hover{border-color:var(--primary-color);box-shadow:0 2px 6px rgba(217,118,6,.2);}
.template-card svg{width:26px;height:26px;color:var(--primary-color);margin-bottom:6px;}
.template-card-name{font-size:12px;font-weight:600;color:#333;}
.backstage-btn{background:var(--primary-color);color:#fff;border:none;padding:10px 20px;border-radius:4px;font-size:13px;cursor:pointer;margin-top:18px;}
.backstage-btn:hover{background:var(--primary-hover);}
.export-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;}
.export-tile{display:flex;align-items:center;gap:14px;background:#fafafa;border:1px solid var(--border-color);border-radius:6px;padding:14px 18px;cursor:pointer;width:260px;transition:.15s;}
.export-tile:hover{border-color:var(--primary-color);box-shadow:0 2px 8px rgba(217,118,6,.18);}
.export-tile svg{width:26px;height:26px;color:var(--primary-color);flex-shrink:0;}

/* ===================== EXCEL-ARTIGES TABELLEN-FENSTER ===================== */
.excel-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1500;display:none;align-items:center;justify-content:center;}
.excel-overlay.open{display:flex;}
.excel-window{background:#fff;width:90%;max-width:900px;height:80%;max-height:640px;border-radius:6px;box-shadow:0 12px 40px rgba(0,0,0,.4);display:flex;flex-direction:column;overflow:hidden;}
.excel-titlebar{background:var(--excel-green);color:#fff;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;}
.excel-titlebar-left{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;}
.excel-titlebar-left svg{width:18px;height:18px;}
.excel-close{background:none;border:none;color:#fff;cursor:pointer;padding:4px;}
.excel-close svg{width:18px;height:18px;}
.excel-toolbar{background:var(--excel-green-light);padding:8px 14px;display:flex;gap:8px;align-items:center;border-bottom:1px solid #c8e2d0;}
.excel-toolbar button{background:#fff;border:1px solid var(--excel-green);color:var(--excel-green-dark);border-radius:3px;padding:5px 10px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:5px;}
.excel-toolbar button:hover{background:var(--excel-green);color:#fff;}
.excel-toolbar button svg{width:13px;height:13px;}
.excel-grid-wrap{flex:1;overflow:auto;padding:10px;}
.excel-grid{border-collapse:collapse;}
.excel-grid td,.excel-grid th{border:1px solid #c8e2d0;padding:0;}
.excel-grid th{background:var(--excel-green);color:#fff;font-size:11px;font-weight:600;width:34px;height:24px;text-align:center;position:sticky;top:0;}
.excel-grid td.rowhead{background:var(--excel-green);color:#fff;font-size:11px;font-weight:600;text-align:center;width:34px;position:sticky;left:0;}
.excel-grid td input{border:none;outline:none;width:90px;height:26px;padding:2px 6px;font-size:12px;font-family:'Calibri',sans-serif;}
.excel-grid td input:focus{background:#fffbe6;box-shadow:inset 0 0 0 2px var(--excel-green);}
.excel-footer{padding:10px 16px;border-top:1px solid var(--border-color);display:flex;justify-content:flex-end;gap:10px;}
.excel-footer button{padding:8px 18px;border-radius:4px;font-size:13px;cursor:pointer;border:1px solid var(--border-color);background:#fff;}
.excel-footer .primary{background:var(--excel-green);color:#fff;border-color:var(--excel-green);}
.excel-footer .primary:hover{background:var(--excel-green-dark);}

/* Tabelle im Dokument (nur Anzeige, nicht editierbar) */
.doc-table{border-collapse:collapse;margin:10px 0;cursor:pointer;}
.doc-table:hover{outline:2px solid var(--excel-green);}
.doc-table td{border:1px solid #999;padding:6px 12px;min-width:40px;font-size:13px;}

/* Shortcuts-Hilfe */
.shortcuts-list{max-width:520px;}
.shortcuts-list tr td:first-child{font-family:Consolas,monospace;background:#f2f2f2;border-radius:3px;padding:4px 8px;font-size:12px;}

::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-thumb{background:#c8c6c4;border-radius:5px;}
::-webkit-scrollbar-track{background:transparent;}
</style>
</head>
<body>

<!-- ============================================================ -->
<!-- STARTSEITE                                                    -->
<!-- ============================================================ -->
<div class="start-screen" id="start-screen">
  <div class="start-header">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
    <h1>AmberNote</h1>
  </div>
  <div class="start-body">
    <div class="start-col">
      <h2>Neu erstellen</h2>
      <div class="start-new-tile" id="start-new-blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
        <div>
          <div class="start-new-tile-title">Leeres Dokument</div>
          <div class="start-new-tile-desc">Neues, leeres Dokument im DIN-A4-Format erstellen</div>
        </div>
      </div>
      <button class="start-open-btn" id="start-open-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        Datei öffnen (.note)
      </button>
      <h2 style="margin-top:32px;">Vorlagen</h2>
      <div class="start-template-grid" id="start-template-grid"></div>
    </div>
    <div class="start-col" style="max-width:340px;">
      <h2>Zuletzt verwendet</h2>
      <div class="start-recent-list" id="start-recent-list">
        <div class="start-recent-empty">Noch keine Dokumente gespeichert.</div>
      </div>
    </div>
  </div>
</div>

<!-- App Header -->
<header class="app-header">
  <div class="app-title">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
    </svg>
    <span>AmberNote -</span>
    <input type="text" id="document-title" class="doc-title-input" value="Unbenanntes Dokument.note">
  </div>
  <div class="header-actions">
    <button class="header-btn" id="btn-home" title="Zur Startseite">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7"></path><path d="M9 22V12h6v10"></path><path d="M5 10v10a1 1 0 0 0 1 1h3m10-11v10a1 1 0 0 1-1 1h-3"></path></svg>
      Start
    </button>
    <button class="header-btn" id="btn-spellcheck-toggle" title="Rechtschreibprüfung ein/aus">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20l-2-2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-5z"></path><path d="M8 10h.01M12 10h.01M16 10h.01"></path></svg>
      Rechtschreibung
    </button>
    <button class="header-btn" id="btn-local-font" title="Lokale Schriftarten laden (Local Font Access API)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16"></path><path d="M6 16 10.5 4h1L16 16"></path><path d="M7.5 12h5"></path></svg>
      Schriftarten
    </button>
  </div>
</header>

<!-- Ribbon Toolbar -->
<div class="ribbon">
  <div class="ribbon-tabs">
    <div class="ribbon-tab file-tab" data-tab="file"><i>Datei</i></div>
    <div class="ribbon-tab active" data-tab="start">Start</div>
    <div class="ribbon-tab" data-tab="insert">Einfügen</div>
    <div class="ribbon-tab" data-tab="layout">Layout</div>
    <div class="ribbon-tab" data-tab="view">Ansicht</div>
  </div>

  <!-- START TAB -->
  <div class="ribbon-content active" data-panel="start">
    <div class="ribbon-group">
      <button class="btn btn-large" id="btn-new" title="Neues Dokument">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
        Neu
      </button>
      <button class="btn btn-large" id="btn-open" title="Dokument Öffnen (.note)">
        <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        Öffnen
      </button>
      <button class="btn btn-large" id="btn-save" title="Dokument Speichern (Strg+S)">
