function saveNoteFile() {
  let filename = docTitleInput.value.trim();
  if (!filename.endsWith('.note')) { filename += '.note'; docTitleInput.value = filename; }

  const pagesHtml = getAllPagesHtml();
  const combinedText = pagesHtml.join(' ').replace(/<[^>]*>/g, ' ');
  const words = combinedText.trim() === '' ? 0 : combinedText.trim().split(/\s+/).length;
  const chars = combinedText.trim().length;

  const noteData = {
    metadata: {
      title: filename,
      noteType: currentNoteType || 'leer',
      created: currentMetadata.created,
      lastModified: new Date().toISOString(),
      wordCount: words,
      charCount: chars,
      pageCount: pagesHtml.length,
      appVersion: "3.0"
    },
    pages: pagesHtml
  };

  const jsonString = JSON.stringify(noteData, null, 2);
  const blob = new Blob([jsonString], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
  addRecentDoc(filename);
  showStatus('Dokument erfolgreich gespeichert');
}
