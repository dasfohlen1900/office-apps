function isLikelyMisspelled(word) {
  const clean = word.toLowerCase().replace(/[.,!?;:()"'„“”]/g, '');
  if (clean.length < 3) return false;
  if (/^\d+$/.test(clean)) return false;
  if (/^[A-ZÄÖÜ]/.test(word) && word.length > 1) return false; /* Eigennamen/Satzanfang tolerieren */
  return !dictionaryWords.has(clean);
}

let spellcheckTimers = new WeakMap();
function scheduleSpellcheck(page) {
  if (!spellcheckEnabled) return;
  clearTimeout(spellcheckTimers.get(page));
  spellcheckTimers.set(page, setTimeout(() => runSpellcheck(page), 700));
}

function runSpellcheck(page) {
  if (!spellcheckEnabled) return;
  saveSelectionRange();
  const walker = document.createTreeWalker(page, NodeFilter.SHOW_TEXT, {
    acceptNode: (node) => {
      if (node.parentElement && node.parentElement.closest('.page-number-tag')) return NodeFilter.FILTER_REJECT;
      if (node.parentElement && node.parentElement.classList.contains('spell-error')) return NodeFilter.FILTER_ACCEPT;
      return NodeFilter.FILTER_ACCEPT;
    }
  });
  const textNodes = [];
  let n;
  while ((n = walker.nextNode())) textNodes.push(n);

  textNodes.forEach(node => {
    const text = node.textContent;
    if (!text || !text.trim()) return;
    const parent = node.parentElement;
    if (parent && parent.classList.contains('spell-error') && text === parent.textContent) return;

    const words = text.split(/(\s+)/);
    let anyMisspelled = false;
    words.forEach(w => { if (w.trim() && isLikelyMisspelled(w)) anyMisspelled = true; });
    if (!anyMisspelled) return;

    const frag = document.createDocumentFragment();
    words.forEach(w => {
      if (w.trim() && isLikelyMisspelled(w)) {
        const span = document.createElement('span');
        span.className = 'spell-error';
        span.textContent = w;
        frag.appendChild(span);
      } else {
        frag.appendChild(document.createTextNode(w));
      }
    });
    node.replaceWith(frag);
  });
  restoreSelectionRange();
}

