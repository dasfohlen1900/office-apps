function createPage(initialHtml) {
  pageCounter++;
  const page = document.createElement('div');
  page.className = 'document-page';
  page.id = 'page-' + pageCounter;
  page.contentEditable = 'true';
  page.spellcheck = false; /* eigene Rechtschreibprüfung übernimmt das */
  page.innerHTML = initialHtml !== undefined ? initialHtml : '<p><br></p>';
  const tag = document.createElement('div');
  tag.className = 'page-number-tag';
  tag.textContent = 'Seite ' + (workspace.querySelectorAll('.document-page').length + 1);
  page.appendChild(tag);
  attachPageEvents(page);
  return page;
}

function attachPageEvents(page) {
  page.addEventListener('mouseup', saveSelectionRange);
  page.addEventListener('keyup', () => { saveSelectionRange(); scheduleSpellcheck(page); updateCounters(); });
  page.addEventListener('input', () => {
    updateCounters();
    currentMetadata.lastModified = new Date().toISOString();
    saveSelectionRange();
    scheduleSpellcheck(page);
  });
  page.addEventListener('focus', () => { activePage = page; });
  page.addEventListener('click', (e) => {
    activePage = page;
    handleEditorClick(e, page);
  });
  page.addEventListener('keydown', (e) => {
    const ctrlOrCmd = e.ctrlKey || e.metaKey;
    if (ctrlOrCmd && e.key === 'Enter') {
      e.preventDefault();
      insertNewPageAfter(page);
    }
  });
}

let activePage = null;

function refreshPageLabels() {
  const pages = workspace.querySelectorAll('.document-page');
