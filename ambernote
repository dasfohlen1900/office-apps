function triggerNewDocument() {
  const hasContent = getAllPagesHtml().join('').replace(/<[^>]*>/g, '').trim().length > 0;
  if (!hasContent || confirm('Möchtest du ein neues Dokument erstellen? Ungespeicherte Änderungen gehen verloren.')) {
    newDocumentWithTemplate('leer');
  }
}
