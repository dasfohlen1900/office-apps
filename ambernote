      });
      spellMenuEl.appendChild(item);
    });
  }
  const sep = document.createElement('div');
  sep.className = 'spell-menu-sep';
  spellMenuEl.appendChild(sep);

  const ignoreItem = document.createElement('div');
  ignoreItem.className = 'spell-menu-item';
  ignoreItem.textContent = 'Ignorieren';
  ignoreItem.addEventListener('click', () => {
    spanEl.replaceWith(document.createTextNode(spanEl.textContent));
