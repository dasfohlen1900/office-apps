    noSug.className = 'spell-menu-item';
    noSug.style.color = '#999';
    noSug.textContent = 'Keine Vorschläge';
    spellMenuEl.appendChild(noSug);
  } else {
    suggestions.forEach(sug => {
      const item = document.createElement('div');
      item.className = 'spell-menu-item';
      item.textContent = sug;
      item.addEventListener('click', () => {
        spanEl.replaceWith(document.createTextNode(sug + ' '));
