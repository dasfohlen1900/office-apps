  });
  spellMenuEl.appendChild(ignoreItem);

  const addDictItem = document.createElement('div');
  addDictItem.className = 'spell-menu-item';
  addDictItem.textContent = 'Zum Wörterbuch hinzufügen';
  addDictItem.addEventListener('click', () => {
    dictionaryWords.add(word.toLowerCase().replace(/[.,!?;:()"'„“”]/g, ''));
    document.querySelectorAll('.spell-error').forEach(el => {
      if (el.textContent.toLowerCase().trim() === word.toLowerCase().trim()) {
        el.replaceWith(document.createTextNode(el.textContent));
      }
    });
    closeSpellMenu();
  });
  spellMenuEl.appendChild(addDictItem);

  document.body.appendChild(spellMenuEl);
}

